# 数据库密码 (必须修改)
DB_PASSWORD=ChangeMe123!

# MinIO 对象存储
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=minio
MINIO_SECRET_KEY=minio123456
# 对外访问 URL 前缀（生产必填，配合 nginx /{bucket}/ 反代，规避 HTTPS Mixed Content）
MINIO_PUBLIC_URL=https://cyneblog.top
# 默认存储桶名称
MINIO_BUCKET=syne-blog
# 随机封面图库存储桶名称
MINIO_COVER_BUCKET=syne-cover

# OpenAI API 配置 (可选)
OPENAI_API_KEY=sk-xxx
OPENAI_BASE_URL=http://127.0.0.1:8045
OPENAI_MODEL=gpt-4o

# 邮件配置 (可选)
SMTP_HOST=smtp.qq.com
SMTP_PORT=587
SMTP_USERNAME=your-email@qq.com
SMTP_PASSWORD=your-smtp-password