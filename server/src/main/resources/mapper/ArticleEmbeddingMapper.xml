<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.syne.server.mapper.ArticleEmbeddingMapper">

    <!-- 根据文章ID删除所有向量 -->
    <delete id="deleteByArticleId">
        DELETE FROM article_embeddings WHERE article_id = #{articleId}
    </delete>

    <!-- 根据文章ID查询所有向量 -->
    <select id="selectByArticleId" resultType="com.syne.server.model.entity.ArticleEmbedding">
        SELECT id, article_id, chunk_index, chunk_content, metadata, created_at, updated_at
        FROM article_embeddings
        WHERE article_id = #{articleId}
        ORDER BY chunk_index
    </select>

</mapper>
