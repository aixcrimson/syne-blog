<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.syne.server.mapper.NavigationCategoryMapper">

    <!-- 根据分类ID统计相关的导航站点数量 -->
    <select id="countSitesByCategoryId" resultType="int">
        SELECT COUNT(*)
        FROM navigation_sites
        WHERE category_id = #{categoryId}
          AND deleted = 0
    </select>

</mapper>